        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding: 3rem 1.5rem;
    max-width: 800px;
  }

  .about-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .about-tagline {
    margin-bottom: 2rem;
  }

  .about-tagline code {
    background: rgba(56, 189, 248, 0.1);
    color: var(--accent-cyan);
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
    font-family: var(--font-mono);
  }

  .about-content h2 {
    font-size: 1.35rem;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--accent-cyan);
  }

  .about-content p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .about-content ul {
    margin-left: 1.5rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .about-content li {
    margin-bottom: 0.6rem;
  }

  .social-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .social-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-glass);
    color: var(--text-main);
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .social-badge:hover {
    background: rgba(56, 189, 248, 0.15);
    border-color: rgba(56, 189, 248, 0.4);
    transform: translateY(-2px);
  }
</style>
