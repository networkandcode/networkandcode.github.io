---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import devtoData from '../../data/devtoArticles.json';
import hashnodeData from '../../data/hashnodeArticles.json';

interface PostItem {
  id: string | number;
  title: string;
  dateStr: string;
  category: string;
  source: 'devto' | 'hashnode' | 'archive';
  url: string;
  description?: string;
  tags?: string[];
  readingTime?: number;
}

const localPosts = await getCollection('blog');

const processedLocalPosts: PostItem[] = localPosts.map((post) => {
  const pathParts = post.id.split('/');
  const filename = pathParts[pathParts.length - 1];
  const dateMatch = filename.match(/^(\d{4}-\d{2}-\d{2})-(.+)$/);

  let dateStr = '2021-01-01';
  let cleanTitle = post.data.title || filename.replace(/\.(md|markdown|html)$/, '').replaceAll('-', ' ');

  if (post.data.date) {
    dateStr = String(post.data.date).slice(0, 10);
  } else if (dateMatch) {
    dateStr = dateMatch[1];
  }

  let category = 'Cloud & DevOps';
  const postStr = (post.id + ' ' + (post.data.tags || '') + ' ' + (post.data.categories || '')).toLowerCase();

  if (postStr.includes('agent') || postStr.includes('ai') || postStr.includes('mcp') || postStr.includes('bedrock') || postStr.includes('gemma')) {
    category = 'Agentic AI & LLMs';
  } else if (postStr.includes('kubernetes') || postStr.includes('k8s') || postStr.includes('helm') || postStr.includes('eks')) {
    category = 'Kubernetes';
  } else if (postStr.includes('otel') || postStr.includes('grafana') || postStr.includes('tracing') || postStr.includes('logging')) {
    category = 'Observability & OTEL';
  } else if (postStr.includes('aws') || postStr.includes('gcp') || postStr.includes('serverless')) {
    category = 'Cloud Architecture';
  } else if (postStr.includes('python')) {
    category = 'Python Automation';
  }

  return {
    id: post.id,
    title: cleanTitle,
    dateStr,
    category,
    source: 'archive',
    url: `/blog/${post.id.replace(/\.(md|markdown|html)$/, '')}`,
    tags: Array.isArray(post.data.tags) ? post.data.tags : typeof post.data.tags === 'string' ? [post.data.tags] : [],
  };
});

const processedDevToPosts: PostItem[] = (devtoData as any[]).map((art) => {
  const dateStr = art.published_at ? art.published_at.slice(0, 10) : '2024-01-01';
  const tagsStr = (art.tag_list || []).join(' ').toLowerCase();
  const textStr = (art.title + ' ' + tagsStr).toLowerCase();

  let category = 'Cloud & DevOps';
  if (textStr.includes('agent') || textStr.includes('ai') || textStr.includes('mcp') || textStr.includes('bedrock') || textStr.includes('gemma') || textStr.includes('llm') || textStr.includes('strands') || textStr.includes('rag')) {
    category = 'Agentic AI & LLMs';
  } else if (textStr.includes('kubernetes') || textStr.includes('k8s') || textStr.includes('helm') || textStr.includes('eks')) {
    category = 'Kubernetes';
  } else if (textStr.includes('otel') || textStr.includes('grafana') || textStr.includes('tracing') || textStr.includes('observability') || textStr.includes('newrelic') || textStr.includes('langfuse')) {
    category = 'Observability & OTEL';
  } else if (textStr.includes('aws') || textStr.includes('gcp') || textStr.includes('serverless') || textStr.includes('cloud')) {
    category = 'Cloud Architecture';
  } else if (textStr.includes('python')) {
    category = 'Python Automation';
  }

  return {
    id: art.id,
    title: art.title,
    dateStr,
    category,
    source: 'devto',
    url: art.url,
    description: art.description,
    tags: art.tag_list || [],
    readingTime: art.reading_time_minutes,
  };
});

const processedHashnodePosts: PostItem[] = (hashnodeData as any[]).map((art) => {
  const dateStr = art.published_at ? art.published_at.slice(0, 10) : '2022-06-01';
  const textStr = (art.title + ' ' + (art.description || '')).toLowerCase();

  let category = 'Cloud & DevOps';
  if (textStr.includes('braille') || textStr.includes('speech') || textStr.includes('appwrite') || textStr.includes('nextjs') || textStr.includes('shop')) {
    category = 'Full-Stack & Cloud Apps';
  } else if (textStr.includes('kubernetes') || textStr.includes('juice')) {
    category = 'Kubernetes';
  } else if (textStr.includes('harperdb') || textStr.includes('database')) {
    category = 'Cloud Architecture';
  }

  return {
    id: art.id,
    title: art.title,
    dateStr,
    category,
    source: 'hashnode',
    url: art.url,
    description: art.description,
  };
});

const allPosts: PostItem[] = [...processedDevToPosts, ...processedHashnodePosts, ...processedLocalPosts].sort((a, b) => (a.dateStr > b.dateStr ? -1 : 1));

const categoriesList = ['All', 'Agentic AI & LLMs', 'Kubernetes', 'Observability & OTEL', 'Full-Stack & Cloud Apps', 'Cloud Architecture', 'Python Automation', 'Cloud & DevOps'];
---

<BaseLayout title="Blog Posts & Technical Articles | Shakir Ahmed Ibrahim" description="Technical blog posts from DEV.to, Hashnode, Kubernetes guides, and AI Agent tutorials by Shakir Ahmed Ibrahim.">
  <div class="container blog-archive-page">
    <header class="archive-header">
      <div class="header-badge">✍️ Technical Blog & Posts</div>
      <h1 class="archive-title">Blog Posts & Articles</h1>
      <p class="archive-subtitle">
        Explore {allPosts.length} technical blog posts across Agentic AI, Kubernetes, OpenTelemetry, AWS, Fullstack, and Cloud Automation.
      </p>

      <div class="channels-banner glass-card">
        <div class="channel-col">
          <div class="channel-info">
            <span class="channel-tag devto">DEV.to</span>
            <span class="channel-desc">{devtoData.length} Cloud, AI & Observability Articles</span>
          </div>
          <a href="https://dev.to/networkandcode" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
            dev.to/networkandcode &rarr;
          </a>
        </div>
        <div class="channel-divider"></div>
        <div class="channel-col">
          <div class="channel-info">
            <span class="channel-tag hashnode">Hashnode</span>
            <span class="channel-desc">{hashnodeData.length} Web Apps & Fullstack Guides</span>
          </div>
          <a href="https://networkandcode.hashnode.dev" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
            networkandcode.hashnode.dev &rarr;
          </a>
        </div>
      </div>

      <div class="search-container">
        <div class="search-box glass-card">
          <span class="search-icon">🔍</span>
          <input 
            type="text" 
            id="blog-search-input" 
            placeholder="Search articles by title or keyword (e.g. Kubernetes, Bedrock, OTEL, Appwrite, NextJS)..." 
            autocomplete="off"
          />
          <button id="clear-search-btn" class="clear-btn" style="display: none;">✕</button>
        </div>

        <div class="category-filters">
          {categoriesList.map((cat, idx) => (
            <button class:list={["filter-chip", { active: idx === 0 }]} data-category={cat}>
              {cat}
            </button>
          ))}
        </div>
      </div>
    </header>

    <div id="no-results" class="no-results-msg glass-card" style="display: none;">
      <p>No articles found matching your search. Try a different query or select "All".</p>
    </div>

    <div class="archive-list" id="articles-container">
      {allPosts.map((post) => (
        <article class="glass-card archive-card" data-title={post.title.toLowerCase()} data-category={post.category}>
          <div class="card-meta">
            <span class="tag-badge">{post.category}</span>
            <div class="meta-right">
              {post.source === 'devto' && <span class="devto-badge">DEV.to</span>}
              {post.source === 'hashnode' && <span class="hashnode-badge">Hashnode</span>}
              {post.source === 'archive' && <span class="local-badge">Archive</span>}
              <time class="post-date">{post.dateStr}</time>
            </div>
          </div>

          <div class="card-main">
            <h2 class="card-title">
              <a 
                href={post.url} 
                target={post.source !== 'archive' ? "_blank" : "_self"} 
                rel={post.source !== 'archive' ? "noopener noreferrer" : ""}
              >
                {post.title}
              </a>
            </h2>
            {post.description && (
              <p class="card-desc">{post.description}</p>
            )}
          </div>

          <div class="card-footer">
            <a 
              href={post.url} 
              target={post.source !== 'archive' ? "_blank" : "_self"} 
              rel={post.source !== 'archive' ? "noopener noreferrer" : ""}
              class="read-link"
            >
              {post.source === 'devto' && 'Read on DEV.to ↗'}
              {post.source === 'hashnode' && 'Read on Hashnode ↗'}
              {post.source === 'archive' && 'Read Archive →'}
            </a>
            {post.source === 'devto' && (
              <span class="source-indicator">dev.to/networkandcode</span>
            )}
            {post.source === 'hashnode' && (
              <span class="source-indicator">networkandcode.hashnode.dev</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('clear-search-btn');
    const filterChips = document.querySelectorAll('.filter-chip');
    const articles = document.querySelectorAll<HTMLElement>('.archive-card');
    const noResultsMsg = document.getElementById('no-results');

    let currentCategory = 'All';
    let currentQuery = '';

    const filterArticles = () => {
      let visibleCount = 0;
      articles.forEach((article) => {
        const title = article.getAttribute('data-title') || '';
        const category = article.getAttribute('data-category') || '';

        const matchesQuery = !currentQuery || title.includes(currentQuery.toLowerCase());
        const matchesCategory = currentCategory === 'All' || category === currentCategory;

        if (matchesQuery && matchesCategory) {
          article.style.display = 'flex';
          visibleCount++;
        } else {
          article.style.display = 'none';
        }
      });

      if (noResultsMsg) {
        noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value.trim();
        if (clearBtn) {
          clearBtn.style.display = currentQuery ? 'block' : 'none';
        }
        filterArticles();
      });
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentQuery = '';
        clearBtn.style.display = 'none';
        searchInput.focus();
        filterArticles();
      });
    }

    filterChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        filterChips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        currentCategory = chip.getAttribute('data-category') || 'All';
        filterArticles();
      });
    });
  });
</script>

<style>
  .blog-archive-page {
    padding: 3rem 1.5rem;
    max-width: 1100px;
  }

  .archive-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .header-badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: var(--accent-blue);
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .archive-title {
    font-size: 2.75rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .archive-subtitle {
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto 1.5rem;
    font-size: 1.1rem;
  }

  .channels-banner {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 1.25rem 1.5rem;
    font-size: 0.95rem;
    max-width: 900px;
    margin: 0 auto 2rem;
    gap: 1.5rem;
  }

  .channel-col {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex: 1;
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .channel-tag {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .channel-tag.devto {
    background: rgba(129, 140, 248, 0.15);
    color: var(--accent-indigo);
    border: 1px solid rgba(129, 140, 248, 0.3);
  }

  .channel-tag.hashnode {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .channel-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .channel-divider {
    width: 1px;
    height: 40px;
    background: var(--border-glass);
  }

  .search-container {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    background: var(--bg-card);
    border: 1px solid var(--border-glass);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-box:focus-within {
    border-color: var(--border-hover);
    box-shadow: 0 0 0 2px var(--glow-blue);
  }

  .search-icon {
    font-size: 1.1rem;
    opacity: 0.6;
  }

  .search-box input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-main);
    font-size: 0.98rem;
    font-family: inherit;
  }

  .search-box input::placeholder {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .clear-btn {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: var(--text-muted);
    border-radius: 50%;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.75rem;
    transition: all 0.2s ease;
  }

  [data-theme="light"] .clear-btn {
    background: rgba(0, 0, 0, 0.08);
  }

  .clear-btn:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .filter-chip {
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-glass);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  [data-theme="light"] .filter-chip {
    background: rgba(0, 0, 0, 0.03);
  }

  .filter-chip:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-main);
    border-color: var(--border-hover);
  }

  [data-theme="light"] .filter-chip:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  .filter-chip.active {
    background: var(--text-main);
    border-color: var(--text-main);
    color: var(--bg-primary);
    font-weight: 600;
  }

  .no-results-msg {
    text-align: center;
    padding: 3rem 1.5rem;
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }

  .archive-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .archive-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .meta-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .devto-badge {
    background: rgba(129, 140, 248, 0.15);
    color: var(--accent-indigo);
    border: 1px solid rgba(129, 140, 248, 0.3);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .hashnode-badge {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.3);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .local-badge {
    background: rgba(148, 163, 184, 0.12);
    color: var(--text-muted);
    border: 1px solid rgba(148, 163, 184, 0.2);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .post-date {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .card-main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .card-title a {
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title a:hover {
    color: var(--accent-blue);
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-glass);
    padding-top: 0.75rem;
    font-size: 0.85rem;
  }

  .read-link {
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: none;
  }

  .read-link:hover {
    text-decoration: underline;
  }

  .source-indicator {
    font-size: 0.78rem;
    color: var(--text-muted);
    opacity: 0.75;
  }

  @media (max-width: 768px) {
    .channels-banner {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
    }

    .channel-divider {
      width: 100%;
      height: 1px;
    }

    .channel-col {
      justify-content: space-between;
    }
  }
</style>
