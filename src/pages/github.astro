---
import BaseLayout from '../layouts/BaseLayout.astro';
import { monthlyContributions } from '../data/githubStats';

const maxContrib = Math.max(...monthlyContributions.map(m => m.count));
---

<BaseLayout title="GitHub Contribution Graph | networkandcode" description="Live contribution graph and commit history for networkandcode on GitHub.">
  <div class="container github-page">
    <header class="page-header">
      <div class="header-badge">🐙 GitHub Activity</div>
      <h1 class="page-title">Contribution Graph</h1>
      <p class="page-subtitle">
        Commit history and contribution matrix from <a href="https://github.com/networkandcode" target="_blank" rel="noopener" class="highlight-link">github.com/networkandcode &rarr;</a>
      </p>

      <div class="github-action-banner glass-card">
        <div>
          <span class="banner-label">GitHub Profile:</span>
          <a href="https://github.com/networkandcode" target="_blank" rel="noopener" class="profile-link">
            github.com/networkandcode
          </a>
        </div>
        <a href="https://github.com/networkandcode" target="_blank" rel="noopener" class="btn-profile-link">
          View on GitHub &rarr;
        </a>
      </div>
    </header>

    <!-- GitHub Contribution Graph -->
    <section class="section">
      <div class="glass-card">
        <div class="card-header-flex">
          <div>
            <h2 class="section-heading">Commit Activity Graph</h2>
            <p class="subtext">Monthly contribution breakdown across open-source repositories and cloud projects.</p>
          </div>
        </div>

        <div class="graph-container">
          {monthlyContributions.map(item => {
            const heightPercent = Math.round((item.count / maxContrib) * 100);
            return (
              <div class="bar-col">
                <div class="bar-tooltip">{item.count} commits</div>
                <div class="bar-wrapper">
                  <div class="bar" style={`height: ${heightPercent}%`}></div>
                </div>
                <span class="bar-label">{item.month.split(' ')[0]}</span>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .github-page {
    padding: 3.5rem 1.5rem;
    max-width: 900px;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .header-badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: rgba(249, 115, 22, 0.15);
    border: 1px solid rgba(249, 115, 22, 0.4);
    color: var(--accent-orange);
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .page-title {
    font-size: 2.75rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-bottom: 1.75rem;
  }

  .highlight-link {
    color: var(--accent-orange);
    font-weight: 600;
  }

  .github-action-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    font-size: 0.95rem;
  }

  .banner-label {
    color: var(--text-muted);
    margin-right: 0.5rem;
  }

  .profile-link {
    font-weight: 700;
  }

  .btn-profile-link {
    background: rgba(249, 115, 22, 0.12);
    color: var(--accent-orange);
    border: 1px solid rgba(249, 115, 22, 0.3);
    padding: 0.4rem 0.9rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn-profile-link:hover {
    background: rgba(249, 115, 22, 0.25);
    color: #ffffff;
  }

  .section {
    margin-bottom: 2rem;
  }

  .section-heading {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .subtext {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
  }

  /* Contribution Graph Styling */
  .graph-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    height: 190px;
    padding-top: 2rem;
    gap: 0.5rem;
  }

  .bar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    height: 100%;
    position: relative;
  }

  .bar-wrapper {
    flex: 1;
    width: 100%;
    max-width: 24px;
    display: flex;
    align-items: flex-end;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    overflow: hidden;
  }

  .bar {
    width: 100%;
    background: linear-gradient(to top, #ea580c, #f97316);
    border-radius: 4px;
    transition: height 0.4s ease;
  }

  .bar-col:hover .bar {
    background: linear-gradient(to top, #f97316, #fbbf24);
    box-shadow: 0 0 12px var(--glow-orange);
  }

  .bar-tooltip {
    position: absolute;
    top: -28px;
    background: var(--bg-surface);
    border: 1px solid var(--border-glass);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .bar-col:hover .bar-tooltip {
    opacity: 1;
  }

  .bar-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .github-action-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
