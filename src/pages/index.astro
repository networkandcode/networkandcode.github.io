---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import cvData from '../data/cv.json';
import { awardsAndCertificates } from '../data/certificates';
import { featuredProjects } from '../data/projects';
import { accreditations } from '../data/accreditations';
import { youtubeVideos } from '../data/videos';
import { githubProfileSummary } from '../data/githubStats';

const posts = await getCollection('blog');

const recentPosts = posts
  .map((post) => {
    const filename = post.id.split('/').pop() || '';
    const dateMatch = filename.match(/^(\d{4}-\d{2}-\d{2})-(.+)$/);
    let dateStr = '2024-01-01';
    if (post.data.date) {
      dateStr = String(post.data.date).slice(0, 10);
    } else if (dateMatch) {
      dateStr = dateMatch[1];
    }
    return {
      title: post.data.title || filename.replace(/\.(md|markdown)$/, '').replaceAll('-', ' '),
      dateStr,
      slug: post.id.replace(/\.(md|markdown)$/, ''),
    };
  })
  .sort((a, b) => (a.dateStr > b.dateStr ? -1 : 1))
  .slice(0, 4);

const coreCompetencies = [
  {
    title: "Cloud Native & DevOps",
    icon: "☁️",
    desc: "Amazon EKS, Google Anthos GKE, Terraform, Ansible, OpenTelemetry, Helm, Argo CD canary deployments."
  },
  {
    title: "Agentic AI & LLMs",
    icon: "🤖",
    desc: "Strands Agents, AWS Bedrock KB, Google ADK Gemma 4, CrewAI screening bots, Model Context Protocol (MCP)."
  },
  {
    title: "Observability & Telemetry",
    icon: "📊",
    desc: "Grafana Cloud, OpenTelemetry (OTEL) Collector, AWS X-Ray, CloudWatch, Langfuse tracing, New Relic."
  },
  {
    title: "Full-Stack & Graph Databases",
    icon: "⚡",
    desc: "Next.js, TypeScript, Appwrite, HarperDB, Neo4j Graph DB, Python FastAPI, GraphQL Apollo."
  }
];

const totalPosts = posts.length;
const totalVideos = youtubeVideos.length;
const totalCerts = accreditations.length;
const totalAwards = awardsAndCertificates.length;
const totalProjects = featuredProjects.length;
---

<BaseLayout title="Shakir Ahmed Ibrahim | Cloud Architecture, AI Systems & Systems Engineering Portfolio">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-badge">⚡ Multi-Domain Development & Systems Engineering</div>
      <h1 class="hero-title">
        Shakir Ahmed Ibrahim
      </h1>
      <p class="hero-subtitle">
        Building and developing resilient Web Applications, Agentic AI Systems, Cloud Infrastructure, Kubernetes Automation, and Enterprise Observability Pipelines.
      </p>

      <!-- Key Impact Metrics Banner -->
      <div class="metrics-grid glass-card">
        <div class="metric-item">
          <span class="metric-num">{githubProfileSummary.totalRepos}+</span>
          <span class="metric-label">Public Repos</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-num">{totalPosts}</span>
          <span class="metric-label">Articles</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-num">{totalCerts}</span>
          <span class="metric-label">Certifications</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-num">{totalAwards}</span>
          <span class="metric-label">Honors & Awards</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-num">{totalVideos}</span>
          <span class="metric-label">Video Tutorials</span>
        </div>
      </div>

      <div class="hero-actions">
        <a href={cvData.url} target="_blank" rel="noopener" class="btn btn-primary">
          Open Official CV (Google Doc) &rarr;
        </a>
        <a href="/github" class="btn btn-secondary">GitHub Activity</a>
      </div>
    </div>
  </section>

  <!-- Professional Development Experience Overview -->
  <section class="section bg-surface-blur">
    <div class="container">
      <div class="glass-card exp-overview-card">
        <div class="card-badge-header">💻 Development & Systems Engineering Journey</div>
        <h2 class="card-block-title" style="margin-bottom: 0.75rem;">Multi-Disciplinary Engineering Background</h2>
        <p class="exp-text">
          Extensive hands-on engineering experience spanning <strong>DevOps/SRE</strong>, <strong>Agentic AI & Generative Workflows</strong>, <strong>Fullstack Web Development</strong>, <strong>Network Automation</strong>, and <strong>Technical Team Leadership</strong> across enterprise cloud environments.
        </p>
        <div class="exp-bullets">
          <div class="exp-bullet-item">
            <span class="bullet-icon">🤖</span>
            <div>
              <strong>Agentic AI & Microservices:</strong> Built conversational AI tools, RAG data analytics agents, Slack Remote MCP Servers, and cost-observability FinOps pipelines with Langfuse and AWS CDK.
            </div>
          </div>
          <div class="exp-bullet-item">
            <span class="bullet-icon">☸️</span>
            <div>
              <strong>Cloud Native & Kubernetes:</strong> Deployed Confluent Kafka on K8s (CFK), Istio TLS pass-through, OpenTelemetry (OTEL) stacks, and 200+ reusable monitoring assets across EKS, GKE, and OpenShift.
            </div>
          </div>
          <div class="exp-bullet-item">
            <span class="bullet-icon">🚀</span>
            <div>
              <strong>Fullstack Web Apps & Automation:</strong> Developed Next.js, Appwrite, and HarperDB applications, Python automation tools, and CI/CD pipelines with Jenkins, Spinnaker, and GitHub Actions.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>







</BaseLayout>

<style>
  .hero-section {
    padding: 4.5rem 0 3.5rem;
    text-align: center;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.4rem 1.1rem;
    border-radius: 9999px;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: var(--accent-blue);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--text-main);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    max-width: 720px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .metrics-grid {
    display: flex;
    justify-content: space-around;
    align-items: center;
    max-width: 900px;
    margin: 0 auto 2.5rem;
    padding: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .metric-num {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--accent-blue);
  }

  .metric-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .metric-divider {
    width: 1px;
    height: 36px;
    background: var(--border-glass);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.75rem 1.75rem;
    border-radius: 12px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, #0284c7, #4f46e5);
    color: #ffffff;
    box-shadow: 0 4px 15px rgba(2, 132, 199, 0.35);
  }

  .btn-primary:hover {
    box-shadow: 0 6px 20px rgba(2, 132, 199, 0.5);
    transform: translateY(-2px);
    color: #ffffff;
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-glass);
    color: var(--text-main);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--accent-blue);
  }

  .btn-sm {
    padding: 0.5rem 1.25rem;
    font-size: 0.85rem;
  }

  .section {
    padding: 4rem 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
  }

  .text-center {
    text-align: center;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;

  }

  .section-subtitle {
    color: var(--text-muted);
    margin-top: 0.4rem;
    font-size: 1rem;
  }

  .view-all-link {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;

  }

  .pillar-card {
    text-align: center;
    padding: 2rem 1.5rem;
  }

  .pillar-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .pillar-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .pillar-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .project-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .pill-group {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tech-tag {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-glass);
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }

  .two-col-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
    gap: 1.75rem;
  }

  .flex-col-between {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .card-badge-header {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-blue);
    margin-bottom: 0.25rem;
  }

  .card-block-title {
    font-size: 1.4rem;
    font-weight: 700;
  }

  .card-block-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.25rem;
    margin-bottom: 1.25rem;
  }

  .cert-compact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  .cert-dot {
    color: var(--accent-blue);
    margin-right: 0.4rem;
  }

  .issuer-text {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .block-btn {
    align-self: flex-start;
    text-align: center;
  }

  .video-preview-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .mini-video-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-main);
  }

  .mini-video-item:hover {
    color: var(--accent-blue);
  }

  .play-icon {
    color: var(--accent-indigo);
    font-size: 0.75rem;
  }

  .github-mini-stats {
    display: flex;
    gap: 1.25rem;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.04);
    padding: 0.75rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--border-glass);
  }

  .stat-num {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--accent-blue);
  }

  .stat-lbl {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .recent-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .post-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .post-title a {
    color: var(--text-main);
  }

  .post-title a:hover {
    color: var(--accent-blue);
  }

  .read-more {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .exp-overview-card {
    padding: 2.25rem 2rem;
  }

  .exp-text {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .exp-bullets {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .exp-bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-main);
  }

  .bullet-icon {
    font-size: 1.25rem;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .two-col-grid {
      grid-template-columns: 1fr;
    }
    .metrics-grid {
      flex-direction: column;
      gap: 1rem;
    }
    .metric-divider {
      display: none;
    }
  }
</style>
