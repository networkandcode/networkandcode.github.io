---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Shakir Ahmed Ibrahim | Cloud Native, DevOps & Systems Engineering Portfolio", 
  description = "Engineering portfolio & technical notes by Shakir Ahmed Ibrahim. Cloud architecture, Kubernetes guides, and AI/ML systems." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-content">
        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/cv">CV / Resume</a>
          <a href="/projects">Projects</a>
          <a href="/accreditations">Certifications</a>
          <a href="/awards">Awards</a>
          <a href="/videos">Videos</a>
          <a href="/github">GitHub Activity</a>
          <a href="/#skills">Skills</a>
          <a href="/blog">Blog</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-content">
        <p>&copy; {new Date().getFullYear()} networkandcode. Cloud Native & Systems Engineering.</p>
        <div class="footer-links">
          <a href="/cv">Live CV</a>
          <a href="/accreditations">Certifications</a>
          <a href="/awards">Awards</a>
          <a href="https://dev.to/networkandcode" target="_blank" rel="noopener">DEV.to</a>
          <a href="https://github.com/networkandcode" target="_blank" rel="noopener">GitHub</a>
          <a href="https://linkedin.com/in/networkandcode" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://www.youtube.com/channel/UCZTRMzFB2HJ6zCDM1n4FhHA" target="_blank" rel="noopener">YouTube</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-glass);
    padding: 1rem 0;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    font-family: var(--font-mono);
    text-decoration: none;
  }

  .brand-accent {
    color: var(--accent-blue);
  }

  .brand-code {
    color: var(--accent-indigo);
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: var(--accent-blue);
  }

  .site-main {
    flex: 1;
  }

  .site-footer {
    border-top: 1px solid var(--border-glass);
    padding: 2rem 0;
    margin-top: 4rem;
    background: var(--bg-surface);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .header-content, .footer-content {
      flex-direction: column;
      gap: 1rem;
    }
    .nav-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }
  }
</style>
