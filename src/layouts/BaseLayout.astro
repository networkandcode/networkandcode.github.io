---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Shakir Ahmed Ibrahim | Cloud Native, DevOps & Systems Engineering Portfolio", 
  description = "Engineering portfolio & technical notes by Shakir Ahmed Ibrahim. Cloud architecture, Kubernetes guides, and AI/ML systems." 
} = Astro.props;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  if (path.startsWith('/#')) return currentPath === '/';
  return currentPath === path || currentPath.startsWith(`${path}/`);
};

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/cv', label: 'CV / Resume' },
  { href: '/projects', label: 'Projects' },
  { href: '/accreditations', label: 'Certifications' },
  { href: '/awards', label: 'Awards' },
  { href: '/videos', label: 'Videos' },
  { href: '/github', label: 'GitHub Activity' },
  { href: '/#skills', label: 'Skills' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-content">
        <nav class="nav-links">
          {navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <a href={item.href} class:list={[{ active }]}>
                {item.label}
              </a>
            );
          })}
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-content">
        <p>&copy; {new Date().getFullYear()} networkandcode. Cloud Native & Systems Engineering.</p>
        <div class="footer-links">
          <a href="/cv">Live CV</a>
          <a href="/accreditations">Certifications</a>
          <a href="/awards">Awards</a>
          <a href="https://dev.to/networkandcode" target="_blank" rel="noopener">DEV.to</a>
          <a href="https://github.com/networkandcode" target="_blank" rel="noopener">GitHub</a>
          <a href="https://linkedin.com/in/networkandcode" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://www.youtube.com/channel/UCZTRMzFB2HJ6zCDM1n4FhHA" target="_blank" rel="noopener">YouTube</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-glass);
    padding: 0.75rem 0;
  }

  .header-content {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav-links a {
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.92rem;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .nav-links a:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .nav-links a.active {
    color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.12);
    border-color: rgba(56, 189, 248, 0.3);
    font-weight: 600;
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.15);
  }

  .site-main {
    flex: 1;
  }

  .site-footer {
    border-top: 1px solid var(--border-glass);
    padding: 2rem 0;
    margin-top: 4rem;
    background: var(--bg-surface);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .header-content, .footer-content {
      flex-direction: column;
      gap: 1rem;
    }
    .nav-links {
      gap: 0.35rem;
    }
    .nav-links a {
      font-size: 0.85rem;
      padding: 0.35rem 0.65rem;
    }
  }
</style>
