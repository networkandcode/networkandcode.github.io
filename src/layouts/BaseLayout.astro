---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Shakir Ahmed Ibrahim | Cloud Native, DevOps & Systems Engineering Portfolio", 
  description = "Engineering portfolio & technical notes by Shakir Ahmed Ibrahim. Cloud architecture, Kubernetes guides, and AI/ML systems." 
} = Astro.props;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  if (path.startsWith('/#')) return currentPath === '/';
  return currentPath === path || currentPath.startsWith(`${path}/`);
};

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/achievements', label: 'Work Achievements' },
  { href: '/blog', label: 'Blog' },
  { href: '/videos', label: 'Videos' },
  { href: '/projects', label: 'Hobby Projects' },
  { href: '/accreditations', label: 'Accreditations & Certifications' },
  { href: '/awards', label: 'Awards' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const initialTheme = savedTheme || (systemDark ? 'dark' : 'dark'); // Default to dark
      document.documentElement.setAttribute('data-theme', initialTheme);
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-content">
        <nav class="nav-links">
          {navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <a href={item.href} class:list={[{ active }]}>
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="header-right">
          <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle navigation menu">
            <span class="hamburger-icon">☰</span>
            <span class="close-icon">✕</span>
          </button>

          <button id="theme-toggle-btn" class="theme-toggle-btn" aria-label="Toggle light and dark theme">
            <span class="sun-icon">☀️</span>
            <span class="moon-icon">🌙</span>
          </button>
        </div>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <script>
      const toggleBtn = document.getElementById('theme-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
          const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', nextTheme);
          localStorage.setItem('theme', nextTheme);
        });
      }

      const menuBtn = document.getElementById('mobile-menu-btn');
      const navLinks = document.querySelector('.nav-links');
      if (menuBtn && navLinks) {
        menuBtn.addEventListener('click', () => {
          const isOpen = navLinks.classList.toggle('mobile-open');
          menuBtn.classList.toggle('active', isOpen);
        });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg-glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-glass);
    padding: 0.75rem 0;
    transition: background 0.25s ease;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-menu-btn {
    display: none;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-glass);
    border-radius: 8px;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text-main);
    font-size: 1.1rem;
    transition: all 0.2s ease;
  }

  [data-theme="light"] .mobile-menu-btn {
    background: rgba(0, 0, 0, 0.05);
  }

  .hamburger-icon { display: block; }
  .close-icon { display: none; }

  .mobile-menu-btn.active .hamburger-icon { display: none; }
  .mobile-menu-btn.active .close-icon { display: block; }

  .nav-links {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .nav-links a {
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.92rem;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .nav-links a:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.06);
  }

  [data-theme="light"] .nav-links a:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .nav-links a.active {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--border-glass);
    font-weight: 600;
  }

  [data-theme="light"] .nav-links a.active {
    background: rgba(0, 0, 0, 0.06);
    border-color: rgba(0, 0, 0, 0.12);
  }

  .theme-toggle-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-glass);
    border-radius: 8px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  [data-theme="light"] .theme-toggle-btn {
    background: rgba(0, 0, 0, 0.05);
  }

  .theme-toggle-btn:hover {
    border-color: var(--border-hover);
    transform: scale(1.05);
  }

  .sun-icon {
    display: none;
    font-size: 0.95rem;
  }

  .moon-icon {
    display: block;
    font-size: 0.95rem;
  }

  [data-theme="light"] .sun-icon {
    display: block;
  }

  [data-theme="light"] .moon-icon {
    display: none;
  }

  .site-main {
    flex: 1;
  }

  @media (max-width: 768px) {
    .mobile-menu-btn {
      display: flex;
    }

    .nav-links {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0.4rem;
      padding-top: 1rem;
      margin-top: 0.75rem;
      border-top: 1px solid var(--border-glass);
    }

    .nav-links.mobile-open {
      display: flex;
    }

    .header-content {
      flex-wrap: wrap;
    }

    .nav-links a {
      width: 100%;
      text-align: left;
      font-size: 0.95rem;
      padding: 0.6rem 0.85rem;
    }
  }
</style>
